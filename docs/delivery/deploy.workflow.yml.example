# INERT BLUEPRINT: planned scripts, runtime, locks and tests do not exist yet.
# Before activation: pin actions to reviewed SHAs and configure protected environments.
name: Planned service delivery
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: llm-regression-lab-delivery
  cancel-in-progress: false
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Require completed Phase 3
        run: test -f requirements.lock && test -d src && test -d tests
      - run: pip install --require-hashes -r requirements.lock
      - run: ruff check src tests && mypy src
      - run: pytest tests/unit tests/adapters tests/evaluation --provider=fake
      - name: Integration dependencies and failure tests
        run: ./scripts/ci-integration.sh
      - name: Dependency and IaC security policy
        run: ./scripts/ci-security.sh
  staging:
    needs: verify
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    environment: staging
    permissions:
      contents: read
      id-token: write
    outputs:
      image_digest: ${{ steps.build.outputs.image_digest }}
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
      - name: Build, scan, attest and push image; output immutable digest
        id: build
        run: ./scripts/build-and-push.sh
      - name: Migrate and deploy staging
        env:
          IMAGE_DIGEST: ${{ steps.build.outputs.image_digest }}
        run: ./scripts/deploy.sh staging
      - name: Full evaluation plus recovery smoke; exits 0, 1 or 2
        run: ./scripts/release-evaluation.sh staging
  production:
    needs: staging
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
      - name: Promote same digest and verify service alarms
        env:
          IMAGE_DIGEST: ${{ needs.staging.outputs.image_digest }}
        run: ./scripts/deploy.sh production
