# NOT BUILDABLE in Phase 2: runtime package and dependency locks are pending.
# Resolve approved base image digests and generate locks before activation.
FROM node:22-bookworm-slim AS node-runtime
FROM python:3.12-slim-bookworm AS runtime
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
# Planned locks include promptfoo and exact Python/Ragas/provider dependencies.
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY package.json package-lock.json /app/
RUN npm ci --omit=dev --ignore-scripts
COPY src/ /app/src/
RUN useradd --uid 10001 --create-home lab
USER 10001:10001
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# ECS command overrides select API, dispatcher, or worker entry point.
CMD ["python", "-m", "llm_regression_lab.api"]
