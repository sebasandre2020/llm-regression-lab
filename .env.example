# Local development only. Replace before starting Compose. Never commit .env.
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=55432
LAB_PORT=18080
# Public development credential, loopback use only. Replace for your local session.
LAB_LOCAL_TOKENS={"local-dev-token-change-me-0123456789abcdef":{"project_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","scopes":["versions:read","versions:write","jobs:read","jobs:write","reports:read"]}}

# Optional real provider; place your key only in ignored .env.
MINIMAX_API_KEY=
